# Copy to .env in cgnat/vps/ and fill in the values.
# docker-compose will automatically load .env from the same directory.

# ── Auth Portal (optional add-on) ────────────────────────────────────
# Not part of this repo. Deploy https://github.com/Xore/auth-backend
# alongside this stack for SSO on your admin surfaces, then copy the
# AUTH_HOST / COOKIE_SECRET / AUTH_PASSWORD / ... vars from that repo's
# own .env.example into this file. See its README for the full list.

# ── Suricata IDS ─────────────────────────────────────────────────────
# Public NIC Suricata sniffs. STRATO VPS default is ens6.
SURICATA_IFACE=ens6

# HOME_NET must be the VPS public IP in CIDR notation — never "any".
# Rules using !$HOME_NET with HOME_NET=any produce a NIL address range
# and cause a fatal parse error at startup.
#
# Get your VPS public IP: curl -s ifconfig.me
# Then set it here as a /32:
SURICATA_HOME_NET=YOUR.VPS.IP.HERE/32

# EXTERNAL_NET should be the inverse of HOME_NET.
# If you have multiple IPs or also want to include the WireGuard range:
#   SURICATA_HOME_NET=[203.0.113.10/32,10.8.0.0/24]
SURICATA_EXTERNAL_NET=!$SURICATA_HOME_NET
